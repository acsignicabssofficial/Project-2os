# ==============================================================================
# Apache Configuration for InfinityFree Web Hosting
# Handles React Single Page Application (SPA) Routing & PHP REST API Execution
# ==============================================================================

Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Allow direct access to existing files and directories (PHP APIs, JS, CSS, Images, SQL)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Prevent routing API requests to index.html if PHP file is missing
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# 3. Route all other client-side requests to index.html (SPA Fallback for React)
RewriteRule ^ index.html [L]

# 4. Security & CORS Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# 5. Default MIME types and Charset
AddDefaultCharset UTF-8
